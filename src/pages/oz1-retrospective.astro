              <tr class="bg-white"><td class="py-1.5 px-3 text-oz-neutral-700">San Francisco, CA</td><td class="py-1.5 px-3 text-right font-semibold text-oz-neutral-900">$816</td><td class="py-1.5 px-3 text-right text-oz-neutral-500">$4,140</td><td class="py-1.5 px-3 text-right text-oz-neutral-500">$143</td></tr>
