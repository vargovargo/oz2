              <tr class="bg-white"><td class="py-1.5 px-3 text-oz-neutral-700">Philadelphia, PA-NJ-DE-MD</td><td class="py-1.5 px-3 text-right font-semibold text-oz-neutral-900">$734</td><td class="py-1.5 px-3 text-right text-oz-neutral-500">$2,142</td><td class="py-1.5 px-3 text-right text-oz-neutral-500">$111</td></tr>
