              <tr class="bg-white"><td class="py-1.5 px-3 text-oz-neutral-700">Los Angeles, CA</td><td class="py-1.5 px-3 text-right font-semibold text-oz-neutral-900">$1,701</td><td class="py-1.5 px-3 text-right text-oz-neutral-500">$1,916</td><td class="py-1.5 px-3 text-right text-oz-neutral-500">$92</td></tr>
              <tr class="bg-white"><td class="py-1.5 px-3 text-oz-neutral-700">Phoenix, AZ</td><td class="py-1.5 px-3 text-right font-semibold text-oz-neutral-900">$1,328</td><td class="py-1.5 px-3 text-right text-oz-neutral-500">$4,274</td><td class="py-1.5 px-3 text-right text-oz-neutral-500">$275</td></tr>
              <tr class="bg-white"><td class="py-1.5 px-3 text-oz-neutral-700">Salt Lake City, UT</td><td class="py-1.5 px-3 text-right font-semibold text-oz-neutral-900">$1,325</td><td class="py-1.5 px-3 text-right text-oz-neutral-500">$15,416</td><td class="py-1.5 px-3 text-right text-oz-neutral-500">$542</td></tr>
