---
import Layout from '@/layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { marked } from 'marked';

const raw = readFileSync(resolve(process.cwd(), 'references.md'), 'utf-8');
const withoutFrontmatter = raw.replace(/^---[\s\S]*?---\n/, '');

marked.setOptions({ gfm: true });
let html = await marked.parse(withoutFrontmatter);

// Badge-ify last_checked dates
html = html.replace(
  /last_checked:\s*(\d{4}-\d{2}-\d{2})/g,
  '<span class="ref-date">checked $1</span>'
);

// Add entry class to every <p> so we can style borders + spacing
html = html.replace(/<p>/g, '<p class="ref-entry">');
---

<Layout title="References" description="All sources cited in the OZ 2.0 resource, with last-checked dates.">
  <div class="max-w-3xl">
    <h1 class="text-3xl font-bold mb-2">References</h1>
    <p class="text-oz-neutral-500 mb-8">
      Every claim in this resource links to an entry below.
      Each entry includes a <code class="text-xs bg-oz-neutral-100 px-1 py-0.5 rounded">last_checked</code> date.
    </p>

    <div
      class="ref-body prose prose-sm max-w-none"
      set:html={html}
    />
  </div>
</Layout>

<style>
  /* Section headers */
  .ref-body :global(h1) { display: none; } /* "# References" is redundant with page h1 */

  .ref-body :global(h2) {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #6b7280;
    margin-top: 2.5rem;
    margin-bottom: 0;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid #e5e7eb;
  }

  .ref-body :global(h3) {
    font-size: 0.85rem;
    font-weight: 600;
    color: #374151;
    margin-top: 1.25rem;
    margin-bottom: 0;
  }

  /* Each reference entry */
  .ref-body :global(.ref-entry) {
    font-size: 0.8rem;
    line-height: 1.6;
    color: #374151;
    margin: 0;
    padding: 0.6rem 0;
    border-bottom: 1px solid #f3f4f6;
  }

  .ref-body :global(.ref-entry:last-child) {
    border-bottom: none;
  }

  /* Entry title (bold part) */
  .ref-body :global(.ref-entry strong) {
    color: #111827;
    font-weight: 600;
  }

  /* Links */
  .ref-body :global(a) {
    color: #2563eb;
    text-decoration: underline;
    text-underline-offset: 2px;
    word-break: break-all;
  }

  .ref-body :global(a:hover) {
    color: #1d4ed8;
  }

  /* last_checked badge */
  .ref-body :global(.ref-date) {
    display: inline-block;
    font-family: ui-monospace, monospace;
    font-size: 0.65rem;
    color: #9ca3af;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    padding: 0 5px;
    border-radius: 3px;
    margin-left: 4px;
    vertical-align: middle;
    white-space: nowrap;
  }

  /* Italic text (lab essay notes, etc.) */
  .ref-body :global(em) {
    color: #9ca3af;
    font-style: italic;
  }

  /* code inline */
  .ref-body :global(code) {
    font-size: 0.7rem;
    background: #f3f4f6;
    padding: 1px 4px;
    border-radius: 3px;
  }
</style>
