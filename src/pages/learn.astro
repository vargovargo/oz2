import Layout from '@/layouts/Layout.astro';
import { getModules, getStudyPrompts, getGlossary } from '@/lib/study';

const modules = getModules();
const prompts = getStudyPrompts();
const glossary = getGlossary();

const anchorSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`;

const moduleShort = Object.fromEntries(modules.map(m => [m.id, m.short]));

function claudeUrl(prompt: string): string {
  return `https://claude.ai/new?q=${encodeURIComponent(prompt)}`;
}

/**
