<style>
  h2 .anchor-link {
    display: inline-flex;
    align-items: center;
    opacity: 0;
    margin-left: 0.4rem;
    color: #9ca3af;
    text-decoration: none;
    vertical-align: middle;
    transition: opacity 0.15s, color 0.15s;
  }
  h2:hover .anchor-link { opacity: 1; }
  .anchor-link:hover { color: #6b7280; }
  .anchor-link.copied { color: #10b981; opacity: 1; }
  .copy-btn.copied { color: #10b981; }
</style>

<script>
  // Section anchor links — copy the URL rather than navigating.
  document.querySelectorAll('.anchor-link').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      navigator.clipboard.writeText(location.origin + location.pathname + a.getAttribute('href')).then(() => {
        a.classList.add('copied');
        setTimeout(() => a.classList.remove('copied'), 1500);
      });
    });
  });

  // Prompt copy buttons.
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.dataset.copy;
      if (!text) return;
      navigator.clipboard.writeText(text).then(() => {
        const original = btn.textContent;
        btn.classList.add('copied');
        btn.textContent = 'Copied';
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.textContent = original;
        }, 1500);
      });
    });
  });

  // Module filtering for the prompt library — same pattern as case-studies.astro.
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter-chip]');
  const cards = document.querySelectorAll<HTMLElement>('[data-prompt-card]');
  const emptyState = document.getElementById('empty-state');
  const active = new Set<string>();

  function applyFilter() {
    let visible = 0;
    cards.forEach(card => {
      const show = active.size === 0 || active.has(card.dataset.module ?? '');
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    emptyState?.classList.toggle('hidden', visible !== 0);

    chips.forEach(chip => {
      const key = chip.dataset.filterChip!;
      const isActive = key === 'all' ? active.size === 0 : active.has(key);
      chip.classList.toggle('bg-oz-blue', isActive);
      chip.classList.toggle('text-white', isActive);
      chip.classList.toggle('border-oz-blue', isActive);
      chip.classList.toggle('bg-white', !isActive);
      chip.classList.toggle('text-oz-neutral-700', !isActive);
      chip.classList.toggle('border-oz-neutral-200', !isActive);
    });
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const key = chip.dataset.filterChip!;
      if (key === 'all') {
        active.clear();
      } else if (active.has(key)) {
        active.delete(key);
      } else {
        active.add(key);
      }
      applyFilter();
    });
  });

  // "5 prompts for this module" links jump to the library with that filter applied.
  document.querySelectorAll<HTMLAnchorElement>('[data-jump-module]').forEach(link => {
    link.addEventListener('click', () => {
      active.clear();
      active.add(link.dataset.jumpModule!);
      applyFilter();
    });
  });
</script>
