const stackLayers = [
  {
    y: 24,
    fill: '#1a4480',
    text: '#ffffff',
    name: 'Equity',
    who: 'QOF / QROF equity · developer equity · foundation PRI',
    note: 'Paid last · first loss · highest return',
  },
  {
    y: 96,
    fill: '#2e8540',
    text: '#ffffff',
    name: 'Gap financing',
    who: 'Grants · EDA infrastructure · soft or deferred loans · credit proceeds',
    note: 'Often never repaid',
  },
  {
    y: 168,
    fill: '#e5a000',
    text: '#1b1b1b',
    name: 'Subordinate debt',
    who: 'CDFI note · EQ2-funded lending · seller financing',
    note: 'Behind the senior lender, priced for it',
  },
  {
    y: 240,
    fill: '#dfe1e6',
