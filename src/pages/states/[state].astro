        )}

        {cra_lmi_tracts != null && (
          <div class="bg-white border border-oz-neutral-200 rounded p-5">
            <p class="font-mono text-2xl font-semibold text-oz-neutral-900 mb-1">
              {cra_lmi_tracts.toLocaleString()}
            </p>
            <p class="text-xs text-oz-neutral-500 mb-2">Eligible tracts with CRA designation (LMI or distressed/underserved)</p>
            <p class="text-xs text-oz-neutral-400 mb-3">
              Banks earn CRA credit for investing in low- or moderate-income tracts (Track 1), and in non-metropolitan middle-income tracts officially designated distressed or underserved by FFIEC (Track 2). When an OZ project sits in a CRA-eligible tract, bank capital can satisfy CRA obligations while generating OZ tax benefits.
              <a href="/capital-stack#cra" class="underline hover:text-oz-neutral-600"> How CRA and OZ interact →</a>
            </p>
            {statePlaces && (
              <div class="text-xs text-oz-neutral-500 space-y-2">
                <p>
                  <span class="font-medium text-oz-neutral-700">Cities: </span>
                  {topCities.map((c, i) => c.name + (i < topCities.length - 1 ? ', ' : '')).join('')}
                  {statePlaces.cities.length > 5 && <span class="text-oz-neutral-400"> and {statePlaces.cities.length - 5} more</span>}
                </p>
                <p>
                  <span class="font-medium text-oz-neutral-700">ZIP codes: </span>
                  <span class="font-mono">{topZips.map((z, i) => z.zip + (i < topZips.length - 1 ? ', ' : '')).join('')}</span>
                  {statePlaces.zips.length > 5 && <span class="text-oz-neutral-400"> and {statePlaces.zips.length - 5} more</span>}
                </p>
                {(statePlaces.cities.length > 5 || statePlaces.zips.length > 5) && (
                  <details class="mt-1">
                    <summary class="cursor-pointer text-oz-blue hover:underline">
                      See all {statePlaces.cities.length} cities and {statePlaces.zips.length} ZIP codes
                    </summary>
                    <div class="mt-2 space-y-2 text-oz-neutral-400">
                      <p class="font-medium text-oz-neutral-600">All cities:</p>
                      <p class="leading-relaxed">
                        {statePlaces.cities.map((c, i) => c.name + (i < statePlaces.cities.length - 1 ? ', ' : '')).join('')}
                      </p>
                      <p class="font-medium text-oz-neutral-600 mt-2">All ZIP codes:</p>
                      <p class="font-mono leading-relaxed">
                        {statePlaces.zips.map((z, i) => z.zip + (i < statePlaces.zips.length - 1 ? ', ' : '')).join('')}
                      </p>
                    </div>
                  </details>
                )}
              </div>
            )}
            <p class="text-xs text-oz-neutral-400 mt-3">
              <a href="https://ffiec.cfpb.gov/tools/tract-search" target="_blank" rel="noopener" class="underline hover:text-oz-neutral-600">Look up a specific tract (FFIEC) →</a>
              {' '}Source: FFIEC Census Flat File 2026, joined to IRS Rev. Proc. 2026-14 eligible tracts.
            </p>
          </div>
        )}

        {ui_invest_q1_tracts != null && (
          <div class="bg-white border border-oz-neutral-200 rounded p-5">
            <p class="font-mono text-2xl font-semibold text-oz-neutral-900 mb-1">{ui_invest_q1_tracts.toLocaleString()}</p>
            <p class="text-xs text-oz-neutral-500 mb-2">Eligible tracts in top investability quintile (Urban Institute model)</p>
