---
import Layout from '@/layouts/Layout.astro';
import { getAllStates } from '@/lib/states';
import type { StateMetadata } from '@/lib/states';

export function getStaticPaths() {
  return getAllStates().map((s) => ({
    params: { state: s.slug },
    props: s,
  }));
}

type Props = StateMetadata;

const state = Astro.props;
const {
  name, fips, total_eligible, rural_eligible, max_designations,
  status_tier, last_checked, lead_agency, process,
  top10_counties, tribal_consultation, rural_partners,
  scoring_rubric_url, state_deadline, application_portal_url,
} = state;

const tierLabel: Record<string, string> = {
  public_process:    'Public process',
  contact_only:      'Contact only',
  no_public_process: 'No public process yet',
};

const tierColor: Record<string, string> = {
  public_process:    'text-oz-green bg-green-50 border-green-200',
  contact_only:      'text-oz-amber bg-amber-50 border-amber-200',
  no_public_process: 'text-oz-neutral-500 bg-oz-neutral-100 border-oz-neutral-200',
};

const today = new Date();
today.setHours(0, 0, 0, 0);
const deadlinePassed = state_deadline
  ? new Date(state_deadline + 'T00:00:00') < today
  : false;

const daysToWindow = Math.ceil(
  (new Date('2026-07-01').getTime() - new Date().getTime()) / (1000 * 60 * 60 * 24)
);
---

<Layout title={name} description={`OZ 2.0 eligible tracts, nomination process, and coalition guidance for ${name}.`}>

  <!-- Breadcrumb -->
  <nav class="text-sm text-oz-neutral-500 mb-6" aria-label="Breadcrumb">
    <a href="/" class="hover:text-oz-blue">Home</a>
    <span class="mx-2">›</span>
    <a href="/states/all" class="hover:text-oz-blue">States</a>
    <span class="mx-2">›</span>
    <span class="text-oz-neutral-900">{name}</span>
  </nav>

  <!-- Header -->
  <div class="mb-8 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
    <h1 class="text-4xl font-bold">{name}</h1>
    <div class="flex flex-col items-start sm:items-end gap-2">
      <span class={`text-sm px-3 py-1 rounded border font-medium ${deadlinePassed ? 'text-oz-neutral-500 bg-oz-neutral-100 border-oz-neutral-200' : tierColor[status_tier]}`}>
        {deadlinePassed ? 'Input closed' : tierLabel[status_tier]}
      </span>
      <p class="text-xs text-oz-neutral-500">Last checked {last_checked}</p>
    </div>
  </div>

  <!-- 1. Headline numbers -->
  <section class="mb-10 grid grid-cols-2 sm:grid-cols-4 gap-4">
    {[
      { label: 'Total eligible tracts', value: total_eligible.toLocaleString() },
      { label: 'Rural eligible',        value: rural_eligible.toLocaleString() },
      { label: 'Max designations (25%)', value: max_designations.toLocaleString() },
      { label: 'Days to nomination window', value: daysToWindow > 0 ? daysToWindow : 'Open' },
    ].map(({ label, value }) => (
      <div class="bg-white border border-oz-neutral-200 rounded p-5">
        <p class="font-mono text-2xl font-semibold text-oz-neutral-900 mb-1">{value}</p>
        <p class="text-xs text-oz-neutral-500">{label}</p>
      </div>
    ))}
  </section>

  <!-- 2. Nomination process -->
  {status_tier === 'no_public_process' && (
    <section class="mb-10 border border-oz-neutral-200 bg-white rounded p-6">
      <h2 class="text-lg font-semibold mb-2">Nomination process</h2>
      <p class="text-oz-neutral-500">
        {name} has not yet published a public nomination process as of {last_checked}.
        This is common — only a minority of states had published guidance as of late April 2026.
        See <a href="/how-to-advocate" class="underline hover:text-oz-neutral-700">how to advocate</a> for steps
        you can take now to engage the governor's office.
      </p>
    </section>
  )}

  {status_tier === 'contact_only' && (
    <section class="mb-10 border border-oz-neutral-200 bg-white rounded p-6">
      <h2 class="text-lg font-semibold mb-2">Nomination process</h2>
      <p class="text-oz-neutral-500 mb-4">
        The lead agency has been identified, but no public process has been published yet.
        Contact information is below. See <a href="/how-to-advocate" class="underline hover:text-oz-neutral-700">how to advocate</a>
        for what to do while the process develops.
      </p>
      {process && <div class="prose prose-sm max-w-none text-oz-neutral-700" set:html={process} />}
    </section>
  )}

  {status_tier === 'public_process' && (
    <section class={`mb-10 rounded p-6 border ${deadlinePassed ? 'border-oz-neutral-200 bg-white' : 'border-green-200 bg-green-50'}`}>
      <h2 class="text-lg font-semibold mb-2">Nomination process</h2>

      {deadlinePassed && (
        <p class="text-sm font-medium text-oz-neutral-500 mb-3">
          Community input window closed {state_deadline}. The state is now in internal review.
        </p>
      )}

      {process
        ? <div class="prose prose-sm max-w-none text-oz-neutral-700" set:html={process} />
        : <p class="text-oz-neutral-500">Process details will be added shortly.</p>
      }
      {scoring_rubric_url && (
        <p class="mt-4 text-sm">
          <a href={scoring_rubric_url} target="_blank" rel="noopener" class="text-oz-blue underline">Scoring rubric →</a>
        </p>
      )}
      {application_portal_url && !deadlinePassed && (
        <p class="mt-2 text-sm">
          <a href={application_portal_url} target="_blank" rel="noopener" class="text-oz-blue underline">Application portal →</a>
        </p>
      )}
      {state_deadline && !deadlinePassed && (
        <p class="mt-2 text-sm text-oz-neutral-700">State deadline: <strong>{state_deadline}</strong></p>
      )}
    </section>
  )}

  <!-- 3. Eligible tracts -->
  <section class="mb-10">
    <h2 class="text-lg font-semibold mb-4">Eligible tracts</h2>
    <div class="bg-white border border-oz-neutral-200 rounded p-6">
      <p class="text-sm text-oz-neutral-500 mb-4">
        Map source: EIG ArcGIS dashboard. Tract list: IRS Rev. Proc. 2026-14 appendix.
      </p>
      <div class="bg-oz-neutral-100 rounded h-64 flex items-center justify-center text-oz-neutral-500 text-sm">
        EIG ArcGIS embed — scope to {name} (FIPS {fips})
      </div>
      <div class="mt-4 flex gap-3 text-sm">
        <a href="https://eig.org/ozs-resources/" target="_blank" rel="noopener" class="text-oz-blue underline">EIG eligibility map</a>
        <a href="https://www.irs.gov/pub/irs-drop/rp-26-14-appendix.xlsx" class="text-oz-blue underline">IRS appendix (XLSX)</a>
      </div>
    </div>

    {top10_counties.length > 0 && (
      <div class="mt-4 bg-white border border-oz-neutral-200 rounded overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-oz-neutral-100 text-oz-neutral-500 text-xs uppercase tracking-wide">
            <tr>
              <th class="px-4 py-2 text-left">County</th>
              <th class="px-4 py-2 text-right">Eligible tracts</th>
            </tr>
          </thead>
          <tbody>
            {top10_counties.map((c, i) => (
              <tr class={i % 2 === 0 ? '' : 'bg-oz-neutral-50'}>
                <td class="px-4 py-2">{c.name}</td>
                <td class="px-4 py-2 text-right font-mono">{c.eligible_count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <!-- 4. How to influence the nomination -->
  <section class="mb-10">
    <h2 class="text-lg font-semibold mb-4">How to influence the nomination</h2>
    <p class="text-oz-neutral-500 text-sm mb-4">
      Detailed coalition checklist at <a href="/how-to-advocate" class="underline hover:text-oz-neutral-700">/how-to-advocate</a>.
      Steps specific to {name} will appear here once the state process is documented.
    </p>
  </section>

  <!-- 5. Who to contact -->
  <section class="mb-10">
    <h2 class="text-lg font-semibold mb-4">Who to contact</h2>
    <div class="bg-white border border-oz-neutral-200 rounded p-6">
      {lead_agency.name ? (
        <div class="mb-4">
          <p class="font-medium text-oz-neutral-900">{lead_agency.name}</p>
          {lead_agency.url && (
            <a href={lead_agency.url} target="_blank" rel="noopener" class="text-oz-blue underline text-sm">{lead_agency.url}</a>
          )}
          {lead_agency.contact_email && (
            <p class="text-sm mt-1"><a href={`mailto:${lead_agency.contact_email}`} class="text-oz-blue underline">{lead_agency.contact_email}</a></p>
          )}
          {lead_agency.contact_phone && (
            <p class="text-sm mt-1">{lead_agency.contact_phone}</p>
          )}
        </div>
      ) : (
        <p class="text-sm text-oz-neutral-500 italic">
          Lead agency for {name} not yet confirmed. Check the
          <a href="https://www.hud.gov/opportunity-zones" target="_blank" rel="noopener" class="underline hover:text-oz-neutral-700"> HUD OZ portal</a> or
          <a href="https://eig.org/ozs-resources/" target="_blank" rel="noopener" class="underline hover:text-oz-neutral-700"> EIG Designation Leads map</a>.
        </p>
      )}

      {rural_partners.usda_rd_url && (
        <div class="mt-4 pt-4 border-t border-oz-neutral-100 text-sm">
          <p class="font-medium text-oz-neutral-900 mb-1">USDA Rural Development</p>
          <a href={rural_partners.usda_rd_url} target="_blank" rel="noopener" class="text-oz-blue underline">{rural_partners.usda_rd_url}</a>
        </div>
      )}
    </div>
  </section>

  <!-- 6. Tribal callout (if applicable) -->
  {tribal_consultation.framework && (
    <section class="mb-10">
      <h2 class="text-lg font-semibold mb-4">Native / tribal</h2>
      <div class="bg-white border border-oz-neutral-200 rounded p-6 text-sm text-oz-neutral-700">
        <p><strong>Consultation framework:</strong> {tribal_consultation.framework}</p>
        {tribal_consultation.citation && <p class="mt-1 text-oz-neutral-500">{tribal_consultation.citation}</p>}
      </div>
    </section>
  )}

  <!-- 7. Sources -->
  <section class="text-xs text-oz-neutral-500">
    <p>
      Eligible tract counts: IRS Rev. Proc. 2026-14 (April 6, 2026).
      Rural designation: Notice 2025-50, Section 4.01.
      Status tier last verified {last_checked}.
      <a href="/methodology" class="underline hover:text-oz-neutral-700">Full methodology</a>.
    </p>
  </section>

</Layout>
