  <!-- 7. Sources -->
  <section class="text-xs text-oz-neutral-500">
    <p>
      {certified && <>Designations: Treasury, 2027 QOZ designations and revised eligible-tract file ({fmt(designation.published)}). Demographics: ACS 2020–2024 5-year. OZ 1.0: IRS Notice 2018-48, crosswalked to 2020 tracts. </>}
      Eligible tract counts: IRS Rev. Proc. 2026-14 (April 6, 2026).
      Rural designation: Notice 2025-50, Section 4.01.
      Status tier last verified {last_checked}.
      <a href="/methodology" class="underline hover:text-oz-neutral-700">Full methodology</a>.
    </p>
  </section>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.tag-chip');
  const rows = document.querySelectorAll<HTMLTableRowElement>('.tract-row');
  const countySel = document.getElementById('county-filter') as HTMLSelectElement | null;
  const countEl = document.getElementById('tract-count');
  const active = new Set<string>();

  function apply() {
    const county = countySel?.value ?? '';
    let shown = 0;
    rows.forEach((r) => {
      const tags = new Set((r.dataset.tags ?? '').split(' '));
      const ok = [...active].every((t) => tags.has(t)) && (!county || r.dataset.county === county);
      r.style.display = ok ? '' : 'none';
      if (ok) shown++;
    });
    if (countEl) countEl.textContent = String(shown);
  }

  chips.forEach((c) => c.addEventListener('click', () => {
    const t = c.dataset.tag!;
    if (active.has(t)) active.delete(t); else active.add(t);
    c.classList.toggle('bg-oz-blue', active.has(t));
    c.classList.toggle('text-white', active.has(t));
    c.classList.toggle('border-oz-blue', active.has(t));
    c.classList.toggle('bg-white', !active.has(t));
    apply();
  }));
  countySel?.addEventListener('change', apply);
</script>

</Layout>
