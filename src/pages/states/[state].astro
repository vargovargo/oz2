---
import Layout from '@/layouts/Layout.astro';
import { getAllStates } from '@/lib/states';
import type { StateMetadata } from '@/lib/states';

export function getStaticPaths() {
  return getAllStates().map((s) => ({
    params: { state: s.slug },
    props: s,
  }));
}

type Props = StateMetadata;

const state = Astro.props;
const {
  name, fips, total_eligible, rural_eligible, max_designations,
  status_tier, last_checked, lead_agency, process,
  top10_counties, tribal_consultation, rural_partners,
  scoring_rubric_url, state_deadline, application_portal_url,
  state_cdfi_count, dci_q1_tracts, pp_county_count, nmtc_projects,
} = state;

// Approximate WGS84 bounding boxes [xmin, ymin, xmax, ymax] keyed by state FIPS string.
// Used to zoom the EIG ArcGIS Dashboard iframe to the right state on load.
const stateExtents: Record<string, [number, number, number, number]> = {
  '01': [-88.47, 30.22, -84.89, 35.01], // AL
  '02': [-179.15, 51.21, -129.97, 71.35], // AK
  '04': [-114.82, 31.33, -109.05, 37.00], // AZ
  '05': [-94.62, 33.00, -89.64, 36.50], // AR
  '06': [-124.41, 32.53, -114.13, 42.01], // CA
  '08': [-109.06, 36.99, -102.04, 41.00], // CO
  '09': [-73.73, 40.99, -71.79, 42.05], // CT
  '10': [-75.79, 38.45, -74.98, 39.84], // DE
  '11': [-77.12, 38.79, -76.91, 38.99], // DC
  '12': [-87.63, 24.52, -80.03, 31.00], // FL
  '13': [-85.61, 30.36, -80.84, 35.00], // GA
  '15': [-160.25, 18.91, -154.81, 22.24], // HI
  '16': [-117.24, 41.99, -111.04, 49.00], // ID
  '17': [-91.51, 36.97, -87.02, 42.51], // IL
  '18': [-88.10, 37.77, -84.78, 41.76], // IN
  '19': [-96.64, 40.37, -90.14, 43.50], // IA
  '20': [-102.05, 36.99, -94.59, 40.00], // KS
  '21': [-89.57, 36.50, -81.96, 39.15], // KY
  '22': [-94.04, 28.93, -89.00, 33.02], // LA
  '23': [-71.08, 43.06, -66.95, 47.46], // ME
  '24': [-79.49, 37.91, -74.98, 39.72], // MD
  '25': [-73.51, 41.23, -69.93, 42.89], // MA
  '26': [-90.42, 41.70, -82.42, 48.19], // MI
  '27': [-97.24, 43.50, -89.49, 49.38], // MN
  '28': [-91.65, 30.17, -88.10, 34.99], // MS
  '29': [-95.77, 35.99, -89.10, 40.61], // MO
  '30': [-116.05, 44.36, -104.04, 49.00], // MT
  '31': [-104.05, 40.00, -95.31, 43.00], // NE
  '32': [-120.01, 35.00, -114.04, 42.00], // NV
  '33': [-72.56, 42.70, -70.70, 45.31], // NH
  '34': [-75.56, 38.93, -73.90, 41.36], // NJ
  '35': [-109.05, 31.33, -103.00, 37.00], // NM
  '36': [-79.76, 40.50, -71.86, 45.01], // NY
  '37': [-84.32, 33.84, -75.46, 36.59], // NC
  '38': [-104.05, 45.94, -96.55, 49.00], // ND
  '39': [-84.82, 38.40, -80.52, 42.00], // OH
  '40': [-103.00, 33.62, -94.43, 37.00], // OK
  '41': [-124.57, 41.99, -116.46, 46.26], // OR
  '42': [-80.52, 39.72, -74.69, 42.27], // PA
  '44': [-71.91, 41.15, -71.12, 42.02], // RI
  '45': [-83.36, 32.05, -78.55, 35.22], // SC
  '46': [-104.06, 42.48, -96.44, 45.95], // SD
  '47': [-90.31, 34.98, -81.65, 36.68], // TN
  '48': [-106.65, 25.84, -93.51, 36.50], // TX
  '49': [-114.05, 36.99, -109.04, 42.00], // UT
  '50': [-73.44, 42.73, -71.50, 45.02], // VT
  '51': [-83.68, 36.54, -75.24, 39.47], // VA
  '53': [-124.73, 45.54, -116.92, 49.00], // WA
  '54': [-82.64, 37.20, -77.72, 40.64], // WV
  '55': [-92.89, 42.49, -86.25, 47.08], // WI
  '56': [-111.06, 40.99, -104.05, 45.01], // WY
  '60': [-171.09, -14.55, -169.41, -11.05], // AS
  '66': [144.62, 13.23, 144.96, 13.66], // GU
  '69': [144.90, 14.11, 146.06, 20.56], // CNMI
  '72': [-67.97, 17.88, -65.23, 18.52], // PR
  '78': [-65.09, 17.68, -64.57, 18.48], // VI
};
const extent = stateExtents[fips] ?? [-130, 23, -65, 50];
const eigMapUrl = `https://www.arcgis.com/apps/dashboards/c473c71f0704408f934fbdc342caf1f1?extent=${extent.join(',')}`;

const tierLabel: Record<string, string> = {
  public_process:    'Public process',
  contact_only:      'Contact only',
  no_public_process: 'No public process yet',
};

const tierColor: Record<string, string> = {
  public_process:    'text-oz-green bg-green-50 border-green-200',
  contact_only:      'text-oz-amber bg-amber-50 border-amber-200',
  no_public_process: 'text-oz-neutral-500 bg-oz-neutral-100 border-oz-neutral-200',
};

const today = new Date();
today.setHours(0, 0, 0, 0);
const deadlinePassed = state_deadline
  ? new Date(state_deadline + 'T00:00:00') < today
  : false;

const daysToWindow = Math.ceil(
  (new Date('2026-07-01').getTime() - new Date().getTime()) / (1000 * 60 * 60 * 24)
);

const daysToStateDeadline = (state_deadline && !deadlinePassed)
  ? Math.ceil((new Date(state_deadline + 'T00:00:00').getTime() - today.getTime()) / (1000 * 60 * 60 * 24))
  : null;
---

<Layout title={name} description={`OZ 2.0 eligible tracts, nomination process, and coalition guidance for ${name}.`}>

  <!-- Breadcrumb -->
  <nav class="text-sm text-oz-neutral-500 mb-6" aria-label="Breadcrumb">
    <a href="/" class="hover:text-oz-blue">Home</a>
    <span class="mx-2">›</span>
    <a href="/states/all" class="hover:text-oz-blue">States</a>
    <span class="mx-2">›</span>
    <span class="text-oz-neutral-900">{name}</span>
  </nav>

  <!-- Header -->
  <div class="mb-8 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
    <h1 class="text-4xl font-bold">{name}</h1>
    <div class="flex flex-col items-start sm:items-end gap-2">
      <span class={`text-sm px-3 py-1 rounded border font-medium ${deadlinePassed ? 'text-oz-neutral-500 bg-oz-neutral-100 border-oz-neutral-200' : tierColor[status_tier]}`}>
        {deadlinePassed ? 'Input closed' : tierLabel[status_tier]}
      </span>
      <p class="text-xs text-oz-neutral-500">Last checked {last_checked}</p>
    </div>
  </div>

  <!-- 1. Headline numbers -->
  <section class="mb-10 grid grid-cols-2 sm:grid-cols-4 gap-4">
    {[
      { label: 'Total eligible tracts', value: total_eligible.toLocaleString() },
      { label: 'Rural eligible',        value: rural_eligible.toLocaleString() },
      { label: 'Max designations (25%)', value: max_designations.toLocaleString() },
      { label: daysToStateDeadline != null ? 'Days to state deadline' : 'Days to federal window',
        value: daysToStateDeadline != null ? daysToStateDeadline : (daysToWindow > 0 ? daysToWindow : 'Open') },
    ].map(({ label, value }) => (
      <div class="bg-white border border-oz-neutral-200 rounded p-5">
        <p class="font-mono text-2xl font-semibold text-oz-neutral-900 mb-1">{value}</p>
        <p class="text-xs text-oz-neutral-500">{label}</p>
      </div>
    ))}
  </section>

  <!-- 2. Nomination process -->
  {status_tier === 'no_public_process' && (
    <section class="mb-10 border border-oz-neutral-200 bg-white rounded p-6">
      <h2 class="text-lg font-semibold mb-2">Nomination process</h2>
      <p class="text-oz-neutral-500">
        {name} has not yet published a public nomination process as of {last_checked}.
        This is common — only a minority of states had published guidance as of late April 2026.
        See <a href="/how-to-advocate" class="underline hover:text-oz-neutral-700">how to advocate</a> for steps
        you can take now to engage the governor's office.
      </p>
    </section>
  )}

  {status_tier === 'contact_only' && (
    <section class="mb-10 border border-oz-neutral-200 bg-white rounded p-6">
      <h2 class="text-lg font-semibold mb-2">Nomination process</h2>
      <p class="text-oz-neutral-500 mb-4">
        The lead agency has been identified, but no public process has been published yet.
        Contact information is below. See <a href="/how-to-advocate" class="underline hover:text-oz-neutral-700">how to advocate</a>
        for what to do while the process develops.
      </p>
      {process && <div class="prose prose-sm max-w-none text-oz-neutral-700" set:html={process} />}
    </section>
  )}

  {status_tier === 'public_process' && (
    <section class={`mb-10 rounded p-6 border ${deadlinePassed ? 'border-oz-neutral-200 bg-white' : 'border-green-200 bg-green-50'}`}>
      <h2 class="text-lg font-semibold mb-2">Nomination process</h2>

      {deadlinePassed && (
        <p class="text-sm font-medium text-oz-neutral-500 mb-3">
          Community input window closed {state_deadline}. The state is now in internal review.
        </p>
      )}

      {process
        ? <div class="prose prose-sm max-w-none text-oz-neutral-700" set:html={process} />
        : <p class="text-oz-neutral-500">Process details will be added shortly.</p>
      }
      {scoring_rubric_url && (
        <p class="mt-4 text-sm">
          <a href={scoring_rubric_url} target="_blank" rel="noopener" class="text-oz-blue underline">Scoring rubric →</a>
        </p>
      )}
      {application_portal_url && !deadlinePassed && (
        <p class="mt-2 text-sm">
          <a href={application_portal_url} target="_blank" rel="noopener" class="text-oz-blue underline">Application portal →</a>
        </p>
      )}
      {state_deadline && !deadlinePassed && (
        <p class="mt-2 text-sm text-oz-neutral-700">State deadline: <strong>{state_deadline}</strong></p>
      )}
    </section>
  )}

  <!-- 3. Eligible tracts -->
  <section class="mb-10">
    <h2 class="text-lg font-semibold mb-4">Eligible tracts</h2>
    <div class="bg-white border border-oz-neutral-200 rounded p-6">
      <iframe
        src={eigMapUrl}
        title={`EIG OZ 2.0 eligibility map — ${name}`}
        class="w-full rounded border-0"
        style="height: 480px;"
        loading="lazy"
        allowfullscreen
      ></iframe>
      <div class="mt-3 flex gap-4 text-xs text-oz-neutral-400">
        <a href="https://www.arcgis.com/apps/dashboards/c473c71f0704408f934fbdc342caf1f1" target="_blank" rel="noopener" class="underline hover:text-oz-neutral-600">Open full map</a>
        <a href="https://www.irs.gov/pub/irs-drop/rp-26-14-appendix.xlsx" class="underline hover:text-oz-neutral-600">IRS appendix (XLSX)</a>
        <span>Source: EIG / IRS Rev. Proc. 2026-14</span>
      </div>
    </div>

    {top10_counties.length > 0 && (
      <div class="mt-4 bg-white border border-oz-neutral-200 rounded overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-oz-neutral-100 text-oz-neutral-500 text-xs uppercase tracking-wide">
            <tr>
              <th class="px-4 py-2 text-left">County</th>
              <th class="px-4 py-2 text-right">Eligible tracts</th>
            </tr>
          </thead>
          <tbody>
            {top10_counties.map((c, i) => (
              <tr class={i % 2 === 0 ? '' : 'bg-oz-neutral-50'}>
                <td class="px-4 py-2">{c.name}</td>
                <td class="px-4 py-2 text-right font-mono">{c.eligible_count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <!-- 4. Data context -->
  {(dci_q1_tracts != null || pp_county_count != null || nmtc_projects != null || state_cdfi_count != null) && (
    <section class="mb-10">
      <h2 class="text-lg font-semibold mb-4">Data context</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

        {dci_q1_tracts != null && (
          <div class="bg-white border border-oz-neutral-200 rounded p-5">
            <p class="font-mono text-2xl font-semibold text-oz-neutral-900 mb-1">{dci_q1_tracts.toLocaleString()}</p>
            <p class="text-xs text-oz-neutral-500 mb-2">Eligible tracts in EIG DCI top distress quintile</p>
            <p class="text-xs text-oz-neutral-400">
              The EIG <a href="https://eig.org/distressed-communities/" target="_blank" rel="noopener" class="underline hover:text-oz-neutral-600">Distressed Communities Index</a> (2019–2023) is
              referenced in many state scoring rubrics. Quintile 1 = most distressed.
            </p>
          </div>
        )}

        {pp_county_count != null && (
          <div class="bg-white border border-oz-neutral-200 rounded p-5">
            <p class="font-mono text-2xl font-semibold text-oz-neutral-900 mb-1">{pp_county_count.toLocaleString()}</p>
            <p class="text-xs text-oz-neutral-500 mb-2">Counties with eligible tracts designated USDA persistent poverty</p>
            <p class="text-xs text-oz-neutral-400">
              Persistent poverty = 20%+ poverty rate in every census 1980–2010.
              Source: <a href="https://www.ers.usda.gov/data-products/county-typology-codes/" target="_blank" rel="noopener" class="underline hover:text-oz-neutral-600">USDA ERS County Typology Codes</a> (2015 edition).
              Relevant for USDA RD program eligibility and QROF rural bonus.
            </p>
          </div>
        )}

        {nmtc_projects != null && (
          <div class="bg-white border border-oz-neutral-200 rounded p-5">
            <p class="font-mono text-2xl font-semibold text-oz-neutral-900 mb-1">
              {nmtc_projects.toLocaleString()}
            </p>
            <p class="text-xs text-oz-neutral-500 mb-2">Prior NMTC investments in eligible OZ tracts</p>
            <p class="text-xs text-oz-neutral-400">
              CDFI Fund <a href="https://www.cdfifund.gov/programs-training/tax-credits/nmtc" target="_blank" rel="noopener" class="underline hover:text-oz-neutral-600">NMTC Public Data Release</a> (2024).
              Indicates prior CDFI capital deployment track record in these tracts.
            </p>
          </div>
        )}

      </div>
    </section>
  )}

  <!-- 5. How to influence the nomination -->
  <section class="mb-10">
    <h2 class="text-lg font-semibold mb-4">How to influence the nomination</h2>
    {status_tier === 'public_process' && !deadlinePassed ? (
      <div class="bg-green-50 border border-green-200 rounded p-5">
        <p class="text-sm font-semibold text-green-800 mb-3">The submission window is open. Here's what to do:</p>
        <ol class="text-sm text-oz-neutral-800 list-decimal list-inside space-y-2">
          <li>Review the full process in the <strong>Nomination process</strong> section above.</li>
          {application_portal_url && (
            <li><a href={application_portal_url} target="_blank" rel="noopener" class="text-oz-blue underline">Open the submission portal →</a></li>
          )}
          {state_deadline && (
            <li>File before the state deadline: <strong>{state_deadline}</strong>.</li>
          )}
          <li>Build your case: document census data, existing development assets, letters of support from partners, and community need.</li>
          <li>For coalition-building tactics and sample language, see <a href="/how-to-advocate" class="underline hover:text-oz-neutral-700">how-to-advocate</a>.</li>
        </ol>
      </div>
    ) : status_tier === 'public_process' && deadlinePassed ? (
      <p class="text-oz-neutral-500 text-sm">
        The state submission window closed {state_deadline}. {name} is in internal review.
        Monitor the lead agency's page for draft recommendations.
      </p>
    ) : (
      <p class="text-oz-neutral-500 text-sm">
        No public process has been announced for {name} yet.
        See <a href="/how-to-advocate" class="underline hover:text-oz-neutral-700">how-to-advocate</a> for
        steps to engage the governor's office and build a coalition now.
      </p>
    )}
  </section>

  <!-- 5. Who to contact -->
  <section class="mb-10">
    <h2 class="text-lg font-semibold mb-4">Who to contact</h2>
    <div class="bg-white border border-oz-neutral-200 rounded p-6">
      {lead_agency.name ? (
        <div class="mb-4">
          <p class="font-medium text-oz-neutral-900">{lead_agency.name}</p>
          {lead_agency.url && (
            <a href={lead_agency.url} target="_blank" rel="noopener" class="text-oz-blue underline text-sm">{lead_agency.url}</a>
          )}
          {lead_agency.contact_email && (
            <p class="text-sm mt-1"><a href={`mailto:${lead_agency.contact_email}`} class="text-oz-blue underline">{lead_agency.contact_email}</a></p>
          )}
          {lead_agency.contact_phone && (
            <p class="text-sm mt-1">{lead_agency.contact_phone}</p>
          )}
        </div>
      ) : (
        <p class="text-sm text-oz-neutral-500 italic">
          Lead agency for {name} not yet confirmed. Check the
          <a href="https://www.hud.gov/opportunity-zones" target="_blank" rel="noopener" class="underline hover:text-oz-neutral-700"> HUD OZ portal</a> or
          <a href="https://eig.org/ozs-resources/" target="_blank" rel="noopener" class="underline hover:text-oz-neutral-700"> EIG Designation Leads map</a>.
        </p>
      )}

      {state_cdfi_count != null && state_cdfi_count > 0 && (
        <div class="mt-4 pt-4 border-t border-oz-neutral-100 text-sm">
          <p class="font-medium text-oz-neutral-900 mb-1">Certified CDFIs</p>
          <p class="text-oz-neutral-700">
            {state_cdfi_count} certified CDFIs headquartered in {name}.{" "}
            <a href="https://www.cdfifund.gov/programs-training/certification/cdfi" target="_blank" rel="noopener" class="text-oz-blue underline">CDFI Fund certified list →</a>
          </p>
        </div>
      )}

      {rural_partners.usda_rd_url && (
        <div class="mt-4 pt-4 border-t border-oz-neutral-100 text-sm">
          <p class="font-medium text-oz-neutral-900 mb-1">USDA Rural Development</p>
          <a href={rural_partners.usda_rd_url} target="_blank" rel="noopener" class="text-oz-blue underline">USDA RD {name} State Office →</a>
        </div>
      )}

      {rural_partners.rcap_regional && (
        <div class="mt-4 pt-4 border-t border-oz-neutral-100 text-sm">
          <p class="font-medium text-oz-neutral-900 mb-1">RCAP Regional Partner</p>
          <a href={rural_partners.rcap_regional.url} target="_blank" rel="noopener" class="text-oz-blue underline">{rural_partners.rcap_regional.name} →</a>
        </div>
      )}

      {rural_partners.rural_lisc && (
        <div class="mt-4 pt-4 border-t border-oz-neutral-100 text-sm">
          <p class="font-medium text-oz-neutral-900 mb-1">Rural LISC</p>
          <a href={rural_partners.rural_lisc.url} target="_blank" rel="noopener" class="text-oz-blue underline">{rural_partners.rural_lisc.name} →</a>
        </div>
      )}
    </div>
  </section>

  <!-- 6. Tribal callout -->
  <section class="mb-10">
    <h2 class="text-lg font-semibold mb-4">Native / tribal</h2>
    <div class="bg-white border border-oz-neutral-200 rounded p-6 text-sm text-oz-neutral-700">
      {tribal_consultation.framework ? (
        <>
          <p>{tribal_consultation.framework}</p>
          {tribal_consultation.citation && <p class="mt-1 text-oz-neutral-500">{tribal_consultation.citation}</p>}
        </>
      ) : (
        <p class="text-oz-neutral-500">
          No formal tribal consultation process has been published for {name}'s OZ 2.0 nomination.
          If your jurisdiction contains or is adjacent to tribal land, contact the relevant
          Tribal Historic Preservation Office (THPO) or tribal government directly before submitting a nomination.
        </p>
      )}
    </div>
  </section>

  <!-- 7. Sources -->
  <section class="text-xs text-oz-neutral-500">
    <p>
      Eligible tract counts: IRS Rev. Proc. 2026-14 (April 6, 2026).
      Rural designation: Notice 2025-50, Section 4.01.
      Status tier last verified {last_checked}.
      <a href="/methodology" class="underline hover:text-oz-neutral-700">Full methodology</a>.
    </p>
  </section>

</Layout>
