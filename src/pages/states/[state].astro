            <a href="/whats-next#reporting" class="text-oz-blue underline">background here</a>.
          </li>
        </ol>
      </div>
    ) : status_tier === 'public_process' && !deadlinePassed ? (
      <div class="bg-green-50 border border-green-200 rounded p-5">
        <p class="text-sm font-semibold text-green-800 mb-3">The submission window is open. Here's what to do:</p>
