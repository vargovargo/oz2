---
import Layout from '@/layouts/Layout.astro';
import { getAllStates, getDesignationDetail, getDesignationAnalysis, TAG_LABELS } from '@/lib/states';
import type { StateMetadata, TractTag } from '@/lib/states';
import craPlaces from '../../../data/cra_lmi_places.json';
import TractMap from '@/components/TractMap.astro';
import { DATES, asOf, currentPhase, daysUntil, fmt } from '@/lib/timeline';

export function getStaticPaths() {
  return getAllStates().map((s) => ({
    params: { state: s.slug },
    props: s,
  }));
}

type Props = StateMetadata;

const state = Astro.props;
const {
  name, fips, total_eligible, rural_eligible, max_designations,
  status_tier, last_checked, lead_agency, process,
  top10_counties, tribal_consultation, rural_partners,
  scoring_rubric_url, state_deadline, application_portal_url,
  state_cdfi_count, dci_q1_tracts, pp_county_count, nmtc_projects, cra_lmi_tracts,
  ui_invest_q1_tracts, nomination, designation,
} = state;

// Final designations (Treasury, Oct 30 2026). See scripts/analyze_designations.py.
const detail = getDesignationDetail(fips);
const profile = getDesignationAnalysis().states.find((p: any) => p.fips === fips);
const tagRules: Record<string, string> = getDesignationAnalysis().meta.tag_rules;
const tagOrder: TractTag[] = ['qrof', 'oz1', 'nmtc', 'cra', 'housing', 'vacancy', 'sweetspot', 'tribal', 'ppov', 'added'];
const tagCounts = Object.fromEntries(tagOrder.map((t) => [t, detail.tracts.filter((x) => x.tags.includes(t)).length]));
const presentTags = tagOrder.filter((t) => tagCounts[t] > 0);
// "favored A, B and C" rather than "favored A, favored B and favored C".
const leaningSentence = (profile?.leaning ?? []).map((l: any, i: number, arr: any[]) => {
  const prev = arr[i - 1]?.text ?? '';
  const t = i > 0 && l.text.startsWith('favored ') && prev.startsWith('favored ') ? l.text.slice(8) : l.text;
  return t + (i < arr.length - 2 ? ', ' : i === arr.length - 2 ? ' and ' : '');
}).join('');
const cdeCount = new Set(detail.tracts.flatMap((t) => t.cdes)).size;
const pct = (n: number, d: number) => (d ? Math.round((n / d) * 100) : 0);
const fmtNum = (v: number | null | undefined, suffix = '') => (v == null ? '—' : `${v.toLocaleString()}${suffix}`);

const statePlaces = (craPlaces as Record<string, { cities: {name:string,tracts:number}[], zips: {zip:string,city:string,tracts:number}[] }>)[fips] ?? null;
const topCities = statePlaces?.cities.slice(0, 5) ?? [];
const topZips   = statePlaces?.zips.slice(0, 5) ?? [];

// Approximate WGS84 bounding boxes [xmin, ymin, xmax, ymax] keyed by state FIPS string.
// Used to zoom the EIG ArcGIS Dashboard iframe to the right state on load.
const stateExtents: Record<string, [number, number, number, number]> = {
  '01': [-88.47, 30.22, -84.89, 35.01], // AL
  '02': [-179.15, 51.21, -129.97, 71.35], // AK
  '04': [-114.82, 31.33, -109.05, 37.00], // AZ
  '05': [-94.62, 33.00, -89.64, 36.50], // AR
  '06': [-124.41, 32.53, -114.13, 42.01], // CA
  '08': [-109.06, 36.99, -102.04, 41.00], // CO
  '09': [-73.73, 40.99, -71.79, 42.05], // CT
  '10': [-75.79, 38.45, -74.98, 39.84], // DE
  '11': [-77.12, 38.79, -76.91, 38.99], // DC
  '12': [-87.63, 24.52, -80.03, 31.00], // FL
  '13': [-85.61, 30.36, -80.84, 35.00], // GA
  '15': [-160.25, 18.91, -154.81, 22.24], // HI
  '16': [-117.24, 41.99, -111.04, 49.00], // ID
  '17': [-91.51, 36.97, -87.02, 42.51], // IL
  '18': [-88.10, 37.77, -84.78, 41.76], // IN
  '19': [-96.64, 40.37, -90.14, 43.50], // IA
  '20': [-102.05, 36.99, -94.59, 40.00], // KS
  '21': [-89.57, 36.50, -81.96, 39.15], // KY
  '22': [-94.04, 28.93, -89.00, 33.02], // LA
  '23': [-71.08, 43.06, -66.95, 47.46], // ME
  '24': [-79.49, 37.91, -74.98, 39.72], // MD
  '25': [-73.51, 41.23, -69.93, 42.89], // MA
  '26': [-90.42, 41.70, -82.42, 48.19], // MI
  '27': [-97.24, 43.50, -89.49, 49.38], // MN
  '28': [-91.65, 30.17, -88.10, 34.99], // MS
  '29': [-95.77, 35.99, -89.10, 40.61], // MO
  '30': [-116.05, 44.36, -104.04, 49.00], // MT
  '31': [-104.05, 40.00, -95.31, 43.00], // NE
  '32': [-120.01, 35.00, -114.04, 42.00], // NV
  '33': [-72.56, 42.70, -70.70, 45.31], // NH
  '34': [-75.56, 38.93, -73.90, 41.36], // NJ
  '35': [-109.05, 31.33, -103.00, 37.00], // NM
  '36': [-79.76, 40.50, -71.86, 45.01], // NY
  '37': [-84.32, 33.84, -75.46, 36.59], // NC
  '38': [-104.05, 45.94, -96.55, 49.00], // ND
  '39': [-84.82, 38.40, -80.52, 42.00], // OH
  '40': [-103.00, 33.62, -94.43, 37.00], // OK
  '41': [-124.57, 41.99, -116.46, 46.26], // OR
  '42': [-80.52, 39.72, -74.69, 42.27], // PA
  '44': [-71.91, 41.15, -71.12, 42.02], // RI
  '45': [-83.36, 32.05, -78.55, 35.22], // SC
  '46': [-104.06, 42.48, -96.44, 45.95], // SD
  '47': [-90.31, 34.98, -81.65, 36.68], // TN
  '48': [-106.65, 25.84, -93.51, 36.50], // TX
  '49': [-114.05, 36.99, -109.04, 42.00], // UT
  '50': [-73.44, 42.73, -71.50, 45.02], // VT
  '51': [-83.68, 36.54, -75.24, 39.47], // VA
  '53': [-124.73, 45.54, -116.92, 49.00], // WA
  '54': [-82.64, 37.20, -77.72, 40.64], // WV
  '55': [-92.89, 42.49, -86.25, 47.08], // WI
  '56': [-111.06, 40.99, -104.05, 45.01], // WY
  '60': [-171.09, -14.55, -169.41, -11.05], // AS
  '66': [144.62, 13.23, 144.96, 13.66], // GU
  '69': [144.90, 14.11, 146.06, 20.56], // CNMI
  '72': [-67.97, 17.88, -65.23, 18.52], // PR
  '78': [-65.09, 17.68, -64.57, 18.48], // VI
};
const extent = stateExtents[fips] ?? [-130, 23, -65, 50];
const eigMapUrl = `https://www.arcgis.com/apps/dashboards/c473c71f0704408f934fbdc342caf1f1?extent=${extent.join(',')}`;

const tierLabel: Record<string, string> = {
  public_process:    'Public process',
  contact_only:      'Contact only',
  no_public_process: 'No public process yet',
};

const tierColor: Record<string, string> = {
  public_process:    'text-oz-green bg-green-50 border-green-200',
  contact_only:      'text-oz-amber bg-amber-50 border-amber-200',
  no_public_process: 'text-oz-neutral-500 bg-oz-neutral-100 border-oz-neutral-200',
};

const today = asOf();
today.setHours(0, 0, 0, 0);
const deadlinePassed = state_deadline
  ? new Date(state_deadline + 'T00:00:00') < today
  : false;

// Program phase drives every date-dependent string on this page. See src/lib/timeline.ts.
const phase = currentPhase();
const windowOpen = phase === 'window_open';
const daysToStateDeadline = (state_deadline && !deadlinePassed)
  ? Math.ceil((new Date(state_deadline + 'T00:00:00').getTime() - today.getTime()) / (1000 * 60 * 60 * 24))
  : null;

// Fourth headline tile: show the nearest live deadline that this reader can still act on,
// and once nothing is actionable, count down to the date the designations bite.
const headlineCounter: { label: string; value: number | string } =
  daysToStateDeadline != null
    ? { label: 'Days to state deadline', value: daysToStateDeadline }
    : windowOpen
      ? { label: 'Days left in federal window', value: Math.max(0, daysUntil(DATES.windowCloses)) }
      : phase === 'awaiting_certification' || phase === 'certified'
        ? { label: 'Days until designations take effect', value: daysUntil(DATES.designationsEffective, undefined, 'start') }
        : { label: 'Designation period ends', value: DATES.designationsExpire.slice(0, 4) };

// Status badge: once the federal window shuts, every state is in the same posture —
// filed and awaiting certification — regardless of what its own input process looked like.
const awaitingCertification = phase === 'awaiting_certification';
const certified = phase === 'certified' || phase === 'designated' || phase === 'post_period';
const badgeLabel = certified
  ? `Designated · ${designation.designated.toLocaleString()} tracts`
  : awaitingCertification
  ? 'Awaiting certification'
  : deadlinePassed
    ? 'Input closed'
    : tierLabel[status_tier];
const badgeColor = certified
  ? 'text-oz-green bg-green-50 border-green-200'
  : awaitingCertification
  ? 'text-oz-blue bg-blue-50 border-blue-200'
  : deadlinePassed
    ? 'text-oz-neutral-500 bg-oz-neutral-100 border-oz-neutral-200'
    : tierColor[status_tier];
---

<Layout title={name} description={certified
  ? `${name}'s ${designation.designated} designated 2027 Opportunity Zones: which tracts were chosen, how they compare to those passed over, and who is already active in them.`
  : `OZ 2.0 eligible tracts, nomination process, and coalition guidance for ${name}.`}>

  <!-- Breadcrumb -->
  <nav class="text-sm text-oz-neutral-500 mb-6" aria-label="Breadcrumb">
    <a href="/" class="hover:text-oz-blue">Home</a>
    <span class="mx-2">›</span>
    <a href="/states/all" class="hover:text-oz-blue">States</a>
    <span class="mx-2">›</span>
    <span class="text-oz-neutral-900">{name}</span>
  </nav>

  <!-- Header -->
  <div class="mb-8 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
    <h1 class="text-4xl font-bold">{name}</h1>
    <div class="flex flex-col items-start sm:items-end gap-2">
      <span class={`text-sm px-3 py-1 rounded border font-medium ${badgeColor}`}>
        {badgeLabel}
      </span>
      <p class="text-xs text-oz-neutral-500">Last checked {last_checked}</p>
    </div>
  </div>

  <!-- 1. Headline numbers -->
  {certified ? (
    <section class="mb-10 grid grid-cols-2 sm:grid-cols-4 gap-4">
      {[
        { label: `Designated tracts (of ${designation.eligible_final.toLocaleString()} eligible)`, value: designation.designated.toLocaleString() },
        { label: 'Rural designated — QROF treatment', value: designation.designated_rural.toLocaleString() },
        { label: 'Former OZ 1.0 tracts redesignated', value: designation.oz1_redesignated.toLocaleString() },
        { label: headlineCounter.label, value: headlineCounter.value },
      ].map(({ label, value }) => (
        <div class="bg-white border border-oz-neutral-200 rounded p-5">
          <p class="font-mono text-2xl font-semibold text-oz-neutral-900 mb-1">{value}</p>
          <p class="text-xs text-oz-neutral-500">{label}</p>
        </div>
      ))}
    </section>
  ) : (
    <section class="mb-10 grid grid-cols-2 sm:grid-cols-4 gap-4">
      {[
        { label: 'Total eligible tracts', value: total_eligible.toLocaleString() },
        { label: 'Rural eligible',        value: rural_eligible.toLocaleString() },
        { label: 'Max designations (25%)', value: max_designations.toLocaleString() },
        { label: headlineCounter.label, value: headlineCounter.value },
      ].map(({ label, value }) => (
        <div class="bg-white border border-oz-neutral-200 rounded p-5">
          <p class="font-mono text-2xl font-semibold text-oz-neutral-900 mb-1">{value}</p>
          <p class="text-xs text-oz-neutral-500">{label}</p>
        </div>
      ))}
    </section>
  )}

  {certified && (
    <>
      <!-- 1a. The designations -->
      <section class="mb-10" id="designations">
        <h2 class="text-lg font-semibold mb-3">How {name} chose</h2>
        <p class="text-sm text-oz-neutral-700 mb-4">
          Treasury published the final list on {fmt(designation.published)}. {name} designated{' '}
          {designation.designated.toLocaleString()} of {designation.eligible_final.toLocaleString()} eligible
          tracts{designation.designated === designation.eligible_final
            ? ' — every eligible tract, because the 25-tract minimum exceeded its eligible count. No selection took place.'
            : `, its full allocation, in ${designation.counties_designated} of ${profile.counties_eligible} counties with eligible tracts.`}
          {' '}Designations take effect {fmt(DATES.designationsEffective)} and run through {fmt(DATES.designationsExpire)}.
          {designation.eligible_final !== total_eligible && (
            <> Treasury's October list has {designation.eligible_final - total_eligible} more eligible tract{designation.eligible_final - total_eligible === 1 ? '' : 's'} here
            than the April appendix, qualified under its missing-data rules; {`${profile.added_oct_designated} ${profile.added_oct_designated === 1 ? 'was' : 'were'} designated.`}</>
          )}
        </p>

        {!profile.full_designation && (
          <>
            {profile.leaning.length > 0 && (
              <p class="text-sm text-oz-neutral-700 mb-4">
                Compared with the eligible tracts it passed over, {name}{' '}
                {leaningSentence}.
              </p>
            )}
            <div class="bg-white border border-oz-neutral-200 rounded overflow-x-auto mb-3">
              <table class="w-full text-sm">
                <thead class="bg-oz-neutral-100 text-oz-neutral-500 text-xs uppercase tracking-wide">
                  <tr>
                    <th class="px-4 py-2 text-left">Trait</th>
                    <th class="px-4 py-2 text-right">Designated</th>
                    <th class="px-4 py-2 text-right">Passed over</th>
                  </tr>
                </thead>
                <tbody>
                  {[
                    ['Former OZ 1.0 tract', fmtNum(profile.oz1_share_designated, '%'), fmtNum(profile.oz1_share_not, '%')],
                    ['Rural (QROF)', fmtNum(profile.rural_share_designated, '%'), fmtNum(profile.rural_share_not, '%')],
                    ['Urban Institute Tier 1', fmtNum(profile.tier1_share_designated, '%'), fmtNum(profile.tier1_share_not, '%')],
                    ['Median poverty rate', fmtNum(profile.poverty_median_designated, '%'), fmtNum(profile.poverty_median_not, '%')],
                    ['Median family income, % of area', fmtNum(profile.mfi_ratio_median_designated, '%'), fmtNum(profile.mfi_ratio_median_not, '%')],
                    ['Residents of color (mean)', fmtNum(profile.nonwhite_designated, '%'), fmtNum(profile.nonwhite_not, '%')],
                    ['Median density, people / sq mi', fmtNum(profile.density_median_designated), fmtNum(profile.density_median_not)],
                  ].map(([k, a, b], i) => (
                    <tr class={i % 2 ? 'bg-oz-neutral-50' : ''}>
                      <td class="px-4 py-2">{k}</td>
                      <td class="px-4 py-2 text-right font-mono">{a}</td>
                      <td class="px-4 py-2 text-right font-mono">{b}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="text-xs text-oz-neutral-500 mb-4">
              Poverty and income: Treasury's own eligibility figures (ACS 2020–2024). Demographics: ACS 2020–2024.
              Former OZ 1.0 = at least half the tract's land area was in a 2018 QOZ.
              <a href="/designations" class="underline hover:text-oz-neutral-700">How every state compares →</a>
            </p>
          </>
        )}

        {detail.oz1_lost > 0 && (
          <div class="border-l-4 border-oz-amber bg-amber-50 pl-4 py-3 pr-4 text-sm text-oz-neutral-700">
            <strong class="text-oz-neutral-900">{detail.oz1_lost.toLocaleString()} OZ 1.0 tract{detail.oz1_lost === 1 ? '' : 's'} in {name} {detail.oz1_lost === 1 ? 'was' : 'were'} not redesignated.</strong>{' '}
            They stay OZ 1.0 zones through {fmt(name === 'Puerto Rico' ? DATES.oz1ExpiresPuertoRico : DATES.oz1Expires)}, but under Notice 2026-40 new
            capital after 2026 generally cannot enter them except under a working capital safe harbor plan adopted by{' '}
            {fmt(DATES.oz1GainInclusion)}. If a project in one of these tracts is mid-stream, that deadline is the one that matters.
            The county table below shows where they are. <a href="/whats-next#transition" class="text-oz-blue underline">Transition rules →</a>
          </div>
        )}
      </section>
    </>
  )}

  {awaitingCertification && (
    <div class="mb-10 border border-blue-200 bg-blue-50 rounded p-5">
      <p class="text-sm text-oz-neutral-700">
        <strong class="text-oz-neutral-900">The nomination window has closed.</strong>{' '}
        {name}'s submission is with Treasury; certified designations take effect {fmt(DATES.designationsEffective)}.
        The process detail below is kept as the record of how {name} gathered input — it is history now,
        not a live channel. See <a href="/whats-next" class="text-oz-blue underline">what happens next</a>.
      </p>
    </div>
  )}

  <!-- 2. Nomination process (history once designations are certified) -->
  <details class="mb-10 group" open={!certified}>
    <summary class={certified ? 'cursor-pointer text-sm text-oz-neutral-500 hover:text-oz-blue mb-4' : 'hidden'}>
      Record: how {name} ran its nomination input process
    </summary>
  {status_tier === 'no_public_process' && (
    <section class="mb-10 border border-oz-neutral-200 bg-white rounded p-6">
      <h2 class="text-lg font-semibold mb-2">Nomination process</h2>
      <p class="text-oz-neutral-500">
        {name} never published a public nomination process; as of {last_checked} the selection was
        made inside the governor's office without an open input channel. That was the case in a
        handful of jurisdictions. The contacts below remain the route to finding out which tracts
        were submitted.
      </p>
    </section>
  )}

  {status_tier === 'contact_only' && (
    <section class="mb-10 border border-oz-neutral-200 bg-white rounded p-6">
      <h2 class="text-lg font-semibold mb-2">Nomination process</h2>
      <p class="text-oz-neutral-500 mb-4">
        {awaitingCertification
          ? `${name} identified a lead agency but never opened a public submission channel. What follows is what was published about its approach; the contacts below are how to ask what was submitted.`
          : 'The lead agency has been identified, but no public process has been published yet. Contact information is below.'}
      </p>
      {process && <div class="prose prose-sm max-w-none text-oz-neutral-700" set:html={process} />}
    </section>
  )}

  {status_tier === 'public_process' && (
    <section class={`mb-10 rounded p-6 border ${deadlinePassed || awaitingCertification ? 'border-oz-neutral-200 bg-white' : 'border-green-200 bg-green-50'}`}>
      <h2 class="text-lg font-semibold mb-2">Nomination process</h2>

      {deadlinePassed && (
        <p class="text-sm font-medium text-oz-neutral-500 mb-3">
          Community input window closed {state_deadline}.
          {awaitingCertification
            ? ' The state has since filed with Treasury.'
            : ' The state is now in internal review.'}
        </p>
      )}

      {process
        ? <div class="prose prose-sm max-w-none text-oz-neutral-700" set:html={process} />
        : <p class="text-oz-neutral-500">Process details will be added shortly.</p>
      }
      {scoring_rubric_url && (
        <p class="mt-4 text-sm">
          <a href={scoring_rubric_url} target="_blank" rel="noopener" class="text-oz-blue underline">Scoring rubric →</a>
        </p>
      )}
      {application_portal_url && !deadlinePassed && !awaitingCertification && (
        <p class="mt-2 text-sm">
          <a href={application_portal_url} target="_blank" rel="noopener" class="text-oz-blue underline">Application portal →</a>
        </p>
      )}
      {state_deadline && !deadlinePassed && (
        <p class="mt-2 text-sm text-oz-neutral-700">State deadline: <strong>{state_deadline}</strong></p>
      )}
    </section>
  )}

  </details>

  <!-- 3. Eligible tracts -->
  <section class="mb-10">
    <h2 class="text-lg font-semibold mb-4">{certified ? 'Map: designated and eligible tracts' : 'Eligible tracts'}</h2>
    <TractMap
      stateFips={fips}
      stateName={name}
      tractCount={certified ? designation.eligible_final : total_eligible}
      eigMapUrl={eigMapUrl}
    />

    {!certified && top10_counties.length > 0 && (
      <div class="mt-4 bg-white border border-oz-neutral-200 rounded overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-oz-neutral-100 text-oz-neutral-500 text-xs uppercase tracking-wide">
            <tr>
              <th class="px-4 py-2 text-left">County</th>
              <th class="px-4 py-2 text-right">Eligible tracts</th>
            </tr>
          </thead>
          <tbody>
            {top10_counties.map((c, i) => (
              <tr class={i % 2 === 0 ? '' : 'bg-oz-neutral-50'}>
                <td class="px-4 py-2">{c.name}</td>
                <td class="px-4 py-2 text-right font-mono">{c.eligible_count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  {certified && detail.tracts.length > 0 && (
    <>
      <!-- 3a. Counties -->
      <section class="mb-10" id="counties">
        <h2 class="text-lg font-semibold mb-2">Designated tracts by county</h2>
        <p class="text-sm text-oz-neutral-700 mb-4">
          The county is usually the first local partner on an OZ deal — zoning, infrastructure, incentives.
          CDEs listed are New Markets Tax Credit allocatees that have already financed deals inside this county's
          designated tracts: the organizations with a working track record of underwriting there.
        </p>
        <div class="bg-white border border-oz-neutral-200 rounded overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-oz-neutral-100 text-oz-neutral-500 text-xs uppercase tracking-wide">
              <tr>
                <th class="px-3 py-2 text-left">County</th>
                <th class="px-3 py-2 text-right">Designated / eligible</th>
                <th class="px-3 py-2 text-right">Rural</th>
                <th class="px-3 py-2 text-right" title="Former OZ 1.0 tracts redesignated / not redesignated">OZ 1.0 kept / lost</th>
                <th class="px-3 py-2 text-right">Residents</th>
                <th class="px-3 py-2 text-left">NMTC CDEs active in designated tracts</th>
              </tr>
            </thead>
            <tbody>
              {detail.counties.filter((c) => c.designated > 0 || c.oz1_lost > 0).map((c, i) => (
                <tr class={`${i % 2 ? 'bg-oz-neutral-50' : ''} align-top`}>
                  <td class="px-3 py-2 whitespace-nowrap">{c.name}</td>
                  <td class="px-3 py-2 text-right font-mono whitespace-nowrap">{c.designated} / {c.eligible}</td>
                  <td class="px-3 py-2 text-right font-mono">{c.rural || '—'}</td>
                  <td class="px-3 py-2 text-right font-mono whitespace-nowrap">{c.oz1_kept} / {c.oz1_lost}</td>
                  <td class="px-3 py-2 text-right font-mono">{c.pop ? c.pop.toLocaleString() : '—'}</td>
                  <td class="px-3 py-2 text-xs text-oz-neutral-600">{c.cdes.length ? c.cdes.join('; ') : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-oz-neutral-500 mt-2">
          Counties with no designated tracts are listed only if they lost OZ 1.0 tracts.
          NMTC: CDFI Fund NMTC public data release. {cdeCount > 0 && `${cdeCount} distinct CDEs across ${name}'s designated tracts.`}
        </p>
      </section>

      <!-- 3b. Tract finder -->
      <section class="mb-10" id="tract-finder">
        <h2 class="text-lg font-semibold mb-2">Find projects and partners in the designated tracts</h2>
        <p class="text-sm text-oz-neutral-700 mb-4">
          Every designated tract in {name}, tagged by the signals that point to a project type or a partner.
          Pick tags to narrow the list — a tract must carry every tag selected. Tags are simple published rules,
          not a score; hover a tag for its definition.
        </p>

        <div class="flex flex-wrap gap-2 mb-3" id="tag-chips">
          {presentTags.map((t) => (
            <button type="button" data-tag={t} title={tagRules[t]}
              class="tag-chip text-xs px-2.5 py-1 rounded-full border border-oz-neutral-300 bg-white text-oz-neutral-700 hover:border-oz-blue">
              {TAG_LABELS[t]} <span class="text-oz-neutral-400 font-mono">{tagCounts[t]}</span>
            </button>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-3 mb-3 text-sm">
          <label class="flex items-center gap-2">
            <span class="text-oz-neutral-500 text-xs">County</span>
            <select id="county-filter" class="border border-oz-neutral-300 rounded px-2 py-1 text-sm bg-white">
              <option value="">All counties</option>
              {detail.counties.filter((c) => c.designated > 0).map((c) => <option value={c.name}>{c.name} ({c.designated})</option>)}
            </select>
          </label>
          <p class="text-xs text-oz-neutral-500"><span id="tract-count" class="font-mono">{detail.tracts.length}</span> of {detail.tracts.length} tracts shown</p>
          <a href="/data/oz2-designations-2027.csv" download class="text-xs text-oz-blue underline ml-auto">Download all eligible tracts, national (CSV) →</a>
        </div>

        <div class="bg-white border border-oz-neutral-200 rounded overflow-x-auto" style="max-height: 640px; overflow-y: auto;">
          <table class="w-full text-sm">
            <thead class="bg-oz-neutral-100 text-oz-neutral-500 text-xs uppercase tracking-wide sticky top-0">
              <tr>
                <th class="px-3 py-2 text-left">Tract</th>
                <th class="px-3 py-2 text-left">County</th>
                <th class="px-3 py-2 text-right" title="Poverty rate">Pov.</th>
                <th class="px-3 py-2 text-right" title="Median family income as % of area median">MFI</th>
                <th class="px-3 py-2 text-right">Pop.</th>
                <th class="px-3 py-2 text-right" title="Renter-occupied share">Rent.</th>
                <th class="px-3 py-2 text-right" title="Housing vacancy rate">Vac.</th>
                <th class="px-3 py-2 text-left">Signals</th>
                <th class="px-3 py-2 text-left">Prior NMTC CDEs</th>
              </tr>
            </thead>
            <tbody id="tract-rows">
              {detail.tracts.map((t) => (
                <tr class="tract-row border-t border-oz-neutral-100 align-top" data-tags={t.tags.join(' ')} data-county={t.county}>
                  <td class="px-3 py-2 whitespace-nowrap">
                    <span class="font-mono text-xs">{t.geoid}</span>
                    {(t.place || t.tribal) && <span class="block text-xs text-oz-neutral-500">{t.place ?? t.tribal}</span>}
                  </td>
                  <td class="px-3 py-2 text-xs whitespace-nowrap">{t.county}</td>
                  <td class="px-3 py-2 text-right font-mono text-xs">{fmtNum(t.pov, '%')}</td>
                  <td class="px-3 py-2 text-right font-mono text-xs">{fmtNum(t.mfi, '%')}</td>
                  <td class="px-3 py-2 text-right font-mono text-xs">{fmtNum(t.pop)}</td>
                  <td class="px-3 py-2 text-right font-mono text-xs">{fmtNum(t.renter, '%')}</td>
                  <td class="px-3 py-2 text-right font-mono text-xs">{fmtNum(t.vac, '%')}</td>
                  <td class="px-3 py-2">
                    <div class="flex flex-wrap gap-1">
                      {t.tags.map((g) => (
                        <span title={tagRules[g]} class={`text-[10px] px-1.5 py-0.5 rounded border whitespace-nowrap ${g === 'qrof' ? 'bg-amber-50 border-amber-200 text-amber-800' : g === 'oz1' ? 'bg-blue-50 border-blue-200 text-oz-blue' : 'bg-oz-neutral-50 border-oz-neutral-200 text-oz-neutral-600'}`}>{TAG_LABELS[g]}</span>
                      ))}
                    </div>
                  </td>
                  <td class="px-3 py-2 text-xs text-oz-neutral-600">
                    {t.cdes.length ? t.cdes.join('; ') : '—'}
                    {t.nmtc_usd > 0 && <span class="block text-oz-neutral-400 font-mono">${(t.nmtc_usd / 1e6).toFixed(1)}M · {t.nmtc_n} deal{t.nmtc_n === 1 ? '' : 's'}</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-4 grid sm:grid-cols-2 gap-4 text-sm">
          <div class="bg-white border border-oz-neutral-200 rounded p-4">
            <p class="font-semibold text-oz-neutral-900 mb-2">Reading the signals for projects</p>
            <ul class="space-y-1.5 text-oz-neutral-700 text-xs">
              <li><strong>Rural / QROF</strong> — a rural QOF investment gets a 30% basis step-up at five years, and existing buildings need only 50% improvement. Rehab of existing stock pencils here in ways it does not elsewhere. <a href="/capital-stack#qrof-mechanics" class="text-oz-blue underline">Mechanics →</a></li>
              <li><strong>Housing pressure</strong> — mostly renters, most of them cost-burdened. Housing deals here have demand; they also carry displacement risk, which is where community benefit terms matter.</li>
              <li><strong>High vacancy</strong> — vacant structures to bring back. Pair with the 50% rural improvement threshold where both apply.</li>
              <li><strong>UI Tier 1</strong> — the Urban Institute's read that private capital is likely to come <em>and</em> the impact would be larger.</li>
            </ul>
          </div>
          <div class="bg-white border border-oz-neutral-200 rounded p-4">
            <p class="font-semibold text-oz-neutral-900 mb-2">Reading the signals for partners</p>
            <ul class="space-y-1.5 text-oz-neutral-700 text-xs">
              <li><strong>NMTC track record</strong> — the listed CDEs have underwritten deals in this exact tract. They know the market and can layer NMTC with OZ equity. <a href="/capital-stack#nmtc" class="text-oz-blue underline">How they stack →</a></li>
              <li><strong>CRA-eligible</strong> — bank investment here earns CRA credit. Start with community development officers at banks with branches in the county.</li>
              <li><strong>Former OZ 1.0</strong> — QOFs and sponsors may already hold assets here. They are the most likely early OZ 2.0 investors and know the local approvals path.</li>
              <li><strong>Tribal</strong> — the tribal government is a principal, not a stakeholder to consult. Persistent poverty — USDA Rural Development programs can fill gaps.</li>
            </ul>
          </div>
        </div>
      </section>
    </>
  )}

  <!-- 4. Data context -->
  {(dci_q1_tracts != null || pp_county_count != null || nmtc_projects != null || state_cdfi_count != null || cra_lmi_tracts != null || ui_invest_q1_tracts != null) && (
    <section class="mb-10">
      <h2 class="text-lg font-semibold mb-4">Data context</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        {dci_q1_tracts != null && (
          <div class="bg-white border border-oz-neutral-200 rounded p-5">
            <p class="font-mono text-2xl font-semibold text-oz-neutral-900 mb-1">{dci_q1_tracts.toLocaleString()}</p>
            <p class="text-xs text-oz-neutral-500 mb-2">Eligible tracts in EIG DCI top distress quintile</p>
            <p class="text-xs text-oz-neutral-400">
              The EIG <a href="https://eig.org/distressed-communities/" target="_blank" rel="noopener" class="underline hover:text-oz-neutral-600">Distressed Communities Index</a> (2019–2023) is
              referenced in many state scoring rubrics. Quintile 1 = most distressed.
              See <a href="/oz1-retrospective#community-critique" class="underline hover:text-oz-neutral-600">whether OZ 1.0 reached the most distressed places →</a>
            </p>
          </div>
        )}

        {pp_county_count != null && (
          <div class="bg-white border border-oz-neutral-200 rounded p-5">
            <p class="font-mono text-2xl font-semibold text-oz-neutral-900 mb-1">{pp_county_count.toLocaleString()}</p>
            <p class="text-xs text-oz-neutral-500 mb-2">Counties with eligible tracts designated USDA persistent poverty</p>
            <p class="text-xs text-oz-neutral-400">
              Persistent poverty = 20%+ poverty rate in every census 1980–2010.
              Source: <a href="https://www.ers.usda.gov/data-products/county-typology-codes/" target="_blank" rel="noopener" class="underline hover:text-oz-neutral-600">USDA ERS County Typology Codes</a> (2015 edition).
              Relevant for USDA RD program eligibility and QROF rural bonus.
