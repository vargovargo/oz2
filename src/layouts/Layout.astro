---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'State-by-state resource for Opportunity Zone 2.0 nominations.' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title} — OZ 2.0 Resource</title>
    <slot name="head" />
  </head>
  <body class="h-full bg-oz-neutral-50 text-oz-neutral-900 flex flex-col">

    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-oz-blue text-white px-4 py-2 rounded">
      Skip to main content
    </a>

    <header class="border-b border-oz-neutral-200 bg-white relative">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-oz-neutral-900 hover:text-oz-blue transition-colors">
          <span class="font-semibold text-lg leading-tight">OZ 2.0</span>
          <span class="text-oz-neutral-300">|</span>
          <span class="text-sm text-oz-neutral-500">State Resource</span>
        </a>

        <!-- Desktop nav -->
        <nav aria-label="Site navigation" class="hidden sm:flex items-center gap-6 text-sm">
          <a href="/states/all" class="text-oz-neutral-700 hover:text-oz-blue transition-colors">States</a>
          <a href="/how-to-advocate" class="text-oz-neutral-700 hover:text-oz-blue transition-colors">How to Advocate</a>
          <a href="/capital-stack" class="text-oz-neutral-700 hover:text-oz-blue transition-colors">Capital Stack</a>
          <a href="/oz1-retrospective" class="text-oz-neutral-700 hover:text-oz-blue transition-colors">OZ 1.0</a>
          <a href="/case-studies" class="text-oz-neutral-700 hover:text-oz-blue transition-colors">Case Studies</a>
          <a href="/methodology" class="text-oz-neutral-700 hover:text-oz-blue transition-colors">Methodology</a>
        </nav>

        <!-- Hamburger button (mobile only) -->
        <button
          id="menu-toggle"
          class="sm:hidden flex flex-col justify-center items-center w-9 h-9 gap-1.5 rounded hover:bg-oz-neutral-100 transition-colors"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="block w-5 h-0.5 bg-oz-neutral-700 transition-all duration-200" id="bar1"></span>
          <span class="block w-5 h-0.5 bg-oz-neutral-700 transition-all duration-200" id="bar2"></span>
          <span class="block w-5 h-0.5 bg-oz-neutral-700 transition-all duration-200" id="bar3"></span>
        </button>
      </div>

      <!-- Mobile menu dropdown -->
      <div
        id="mobile-menu"
        class="sm:hidden hidden border-t border-oz-neutral-200 bg-white absolute w-full z-50 shadow-md"
        aria-label="Mobile navigation"
      >
        <nav class="flex flex-col px-4 py-3 gap-0 text-sm">
          <a href="/states/all" class="py-3 border-b border-oz-neutral-100 text-oz-neutral-700 hover:text-oz-blue transition-colors">States</a>
          <a href="/how-to-advocate" class="py-3 border-b border-oz-neutral-100 text-oz-neutral-700 hover:text-oz-blue transition-colors">How to Advocate</a>
          <a href="/capital-stack" class="py-3 border-b border-oz-neutral-100 text-oz-neutral-700 hover:text-oz-blue transition-colors">Capital Stack</a>
          <a href="/oz1-retrospective" class="py-3 border-b border-oz-neutral-100 text-oz-neutral-700 hover:text-oz-blue transition-colors">OZ 1.0</a>
          <a href="/case-studies" class="py-3 border-b border-oz-neutral-100 text-oz-neutral-700 hover:text-oz-blue transition-colors">Case Studies</a>
          <a href="/methodology" class="py-3 text-oz-neutral-700 hover:text-oz-blue transition-colors">Methodology</a>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1 max-w-6xl mx-auto w-full px-4 sm:px-6 py-10">
      <slot />
    </main>

    <footer class="border-t border-oz-neutral-200 bg-white mt-auto">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-sm text-oz-neutral-500">
        <p>
          Data: <a href="/references" class="underline hover:text-oz-neutral-700">IRS Rev. Proc. 2026-14</a> and other sources.
          Nomination window opens <strong class="text-oz-neutral-700">July 1, 2026</strong>.
        </p>
        <nav aria-label="Footer navigation" class="flex gap-4">
          <a href="/methodology" class="hover:text-oz-neutral-700">Methodology</a>
          <a href="/references" class="hover:text-oz-neutral-700">References</a>
          <a href="/about" class="hover:text-oz-neutral-700">About</a>
          <a href="/downloads/eligible_tracts.parquet" download class="hover:text-oz-neutral-700">Eligible Tracts (parquet)</a>
        </nav>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const bar1 = document.getElementById('bar1');
      const bar2 = document.getElementById('bar2');
      const bar3 = document.getElementById('bar3');

      toggle?.addEventListener('click', () => {
        const isOpen = menu?.classList.toggle('hidden') === false;
        toggle.setAttribute('aria-expanded', String(isOpen));
        // Animate bars into X when open
        if (isOpen) {
          bar1?.classList.add('rotate-45', 'translate-y-2');
          bar2?.classList.add('opacity-0');
          bar3?.classList.add('-rotate-45', '-translate-y-2');
        } else {
          bar1?.classList.remove('rotate-45', 'translate-y-2');
          bar2?.classList.remove('opacity-0');
          bar3?.classList.remove('-rotate-45', '-translate-y-2');
        }
      });

      // Close menu when a link is clicked
      menu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
          toggle?.setAttribute('aria-expanded', 'false');
          bar1?.classList.remove('rotate-45', 'translate-y-2');
          bar2?.classList.remove('opacity-0');
          bar3?.classList.remove('-rotate-45', '-translate-y-2');
        });
      });
    </script>

  </body>
</html>
